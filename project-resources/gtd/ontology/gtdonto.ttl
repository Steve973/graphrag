gtd:INC_198812210003 a gtd:Incident,
        owl:NamedIndividual ;
    gtd:IncID "198812210003" ;
    gtd:hasAttackType gtd:ATTK_198812210003 ;
    gtd:hasInclusionCriteria gtd:INCRT_198812210003 ;
